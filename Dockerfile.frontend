ARG NODE_VERSION=20
FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

ARG NODE_VERSION=20
FROM node:${NODE_VERSION}-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules
COPY frontend/docker-entrypoint.sh /usr/local/bin/career-agent-frontend-entrypoint
RUN chmod +x /usr/local/bin/career-agent-frontend-entrypoint

EXPOSE 3000
ENTRYPOINT ["career-agent-frontend-entrypoint"]
CMD ["npm", "run", "start"]
