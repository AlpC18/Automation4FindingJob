# ============================================================
# Autonomous Career Agent Engine - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ---- LLM Provider Selection ----
# Options: auto | openai | anthropic | gemini | deepseek | ollama | local_fallback
# "auto" tries providers in order until one works
ACTIVE_LLM_PROVIDER=auto

# ---- API Security ----
# Generate APP_ENCRYPTION_KEY with Fernet.generate_key().
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000/api
API_AUTH_TOKEN=
APP_ENCRYPTION_KEY=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=20
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Production: set a long random secret (e.g. `openssl rand -hex 32`) before enabling sign-in.
AUTH_SECRET_KEY=
# Compose defaults to tenant login; set false only for a trusted single-user deployment.
MULTI_TENANT_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///backend/data/career_engine.db
# Local SQLite: encrypted automatic backups are made at startup and on this interval.
BACKUP_DIR=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_SIZE_MB=512
# Docker Compose ignores DATABASE_URL and defaults to Postgres; these only override it when non-empty.
COMPOSE_DATABASE_URL=
VECTOR_BACKEND=auto
VECTOR_DIMENSIONS=384
STARTUP_SEED_ENABLED=false
AUTO_START_DAEMON=false
# Keep false for real deployments; enable only for local demo fixtures.
DEMO_DATA_ENABLED=false
# Compose runs the always-on scheduler in the separate daemon-worker service.
# Set AUTO_START_DAEMON=true only when the API process should also own the scheduler.

# ---- Dynamic sourcing & scheduler ----
SCRAPER_MODE=auto
SCRAPER_PLATFORMS=linkedin,upwork,kosovajob,remote
DEFAULT_SCRAPE_QUERY=Developer
SCHEDULER_TIMEZONE=Europe/Belgrade
SCHEDULER_NIGHTLY_TIME=03:30
SCHEDULER_MORNING_TIME=08:00
DAEMON_POLL_SECONDS=45
MORNING_MIN_MATCH_SCORE=75
MORNING_DRAFT_LIMIT=3

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy
# Provider: openai | edge | auto (auto uses Edge when OPENAI_API_KEY is empty)
VOICE_TTS_PROVIDER=openai
VOICE_EDGE_TTS_VOICE=en-US-AriaNeural

# ---- Anthropic Claude ----
ANTHROPIC_API_KEY=
# Cheaper option: claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-5-5
# Daily cap on Anthropic tokens (input + output); 0 disables the cap.
LLM_DAILY_TOKEN_BUDGET=200000

# ---- Google Gemini ----
GEMINI_API_KEY=

# ---- DeepSeek ----
DEEPSEEK_API_KEY=

# ---- Local Ollama (Free, no API key needed) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Platform / Sourcing APIs ----
APIFY_API_TOKEN=
# Choose maintained Apify Actors for portal sources (actor owner/name or owner~name).
APIFY_ACTOR_LINKEDIN=
APIFY_ACTOR_UPWORK=
APIFY_ACTOR_KOSOVAJOB=
# JSON input overrides are actor-specific; query/keyword/location are supplied automatically when absent.
APIFY_INPUT_LINKEDIN={}
APIFY_INPUT_UPWORK={}
APIFY_INPUT_KOSOVAJOB={}
APIFY_TIMEOUT_SECONDS=90
APIFY_MAX_ITEMS_PER_RUN=100
APIFY_MAX_ACTOR_RUNS_PER_DAY=20
APIFY_MAX_TOTAL_CHARGE_USD=1.0
JOB_SOURCE_TIMEOUT_SECONDS=20
JOB_SOURCE_USER_AGENT=AutonomousCareerAgent/1.0 (job aggregator)
REMOTEOK_API_URL=https://remoteok.com/api
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
# Company career boards to scan: provider:company, provider is greenhouse, lever or ashby.
# Example: COMPANY_BOARDS=greenhouse:stripe,lever:spotify,ashby:ramp
COMPANY_BOARDS=
APOLLO_API_KEY=

# ---- Proxy & Stealth ----
RESIDENTIAL_PROXY_URL=
# STEALTH_BROWSER_HEADLESS=true

# ---- SMTP (Email Outreach) ----
# Required for real email dispatch to decision makers
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ---- Daily Rate Limits (Account Safety) ----
# DAILY_LIMIT_LINKEDIN=25
# DAILY_LIMIT_UPWORK=20
# DAILY_LIMIT_KOSOVAJOB=35
# DAILY_LIMIT_GLOBAL_REMOTE=30

# ---- Detection Thresholds ----
# GHOST_JOB_DAYS_THRESHOLD=45
# MIN_ATS_MATCH_SCORE=70

# ---- Distributed Task Queue (Celery + Redis) ----
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false
# Required by Docker Compose; generate a random hex value for each deployment.
REDIS_PASSWORD=
COMPOSE_REDIS_URL=

# ---- Docker build/runtime sizing ----
PYTHON_VERSION=3.11
NODE_VERSION=20
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
# Required by Docker Compose; generate a random hex value for each deployment.
POSTGRES_PASSWORD=
REDIS_PORT=6379
UVICORN_WORKERS=1
CELERY_WORKER_CONCURRENCY=2
POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine

# ---- Official OAuth2 (Gmail & Outlook) ----
# Optional: for 1-click Google Cloud / Azure AD authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/inbox/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/inbox/oauth/microsoft/callback

# ---- Frontend (only needed for Docker) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Only set for a trusted single-user install; never reuse API_AUTH_TOKEN here.
PUBLIC_API_AUTH_TOKEN=

# Morning summary and alerts on Telegram: create a bot with @BotFather, then set both values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
