# ==============================================================================
# OTONOM İŞ BULMA SİSTEMİ - ÇEVRE DEĞİŞKENLERİ (.env.example)
# ==============================================================================
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizle güncelleyin:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. GENEL SUNUCU VE ÇALIŞMA AYARLARI
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # development | production | test
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
PROJECT_NAME="Autonomous Career Agent Engine"
VERSION=1.0.0

# Backend Host & Port
API_HOST=127.0.0.1                     # Docker için 0.0.0.0 önerilir
API_PORT=18000                         # Backend portu (varsayılan: 8000 veya 18000)
BACKEND_PUBLIC_URL=http://localhost:18000
FRONTEND_PUBLIC_URL=http://localhost:13000
PUBLIC_API_URL=http://localhost:18000/api
CORS_ORIGINS="http://localhost:13000,http://127.0.0.1:13000,http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------------------------------------------
# 2. GÜVENLİK VE KİMLİK DOĞRULAMA
# ------------------------------------------------------------------------------
# Production modunda en az 32 karakter olmalıdır:
API_AUTH_TOKEN=
AUTH_SECRET_KEY=
APP_ENCRYPTION_KEY=                    # Fernet anahtarı (örn: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MULTI_TENANT_ENABLED=false
DEMO_DATA_ENABLED=false

# ------------------------------------------------------------------------------
# 3. VERİTABANI VE VEKTÖR DEPOLAMA
# ------------------------------------------------------------------------------
# SQLite (varsayılan) veya PostgreSQL bağlantı dizesi
# SQLite örneği: sqlite:///backend/data/career_engine.db
# PostgreSQL örneği: postgresql+psycopg://kullanici:sifre@localhost:5432/career_engine
DATABASE_URL=
CHROMA_PERSIST_DIR=                    # Varsayılan: backend/data/chroma_db
VECTOR_BACKEND=auto                    # auto | chromadb | pgvector
VECTOR_DIMENSIONS=384

# ------------------------------------------------------------------------------
# 4. YAPAY ZEKA (LLM) SAĞLAYICILARI (İsteğe Bağlı)
# ------------------------------------------------------------------------------
# Hiçbiri girilmezse yerel akıllı kural motoru devreye girer.
ACTIVE_LLM_PROVIDER=auto               # auto | openai | anthropic | gemini | deepseek | ollama | custom

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_DAILY_TOKEN_BUDGET=200000

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Ollama (Yerel LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Özel OpenAI-Uyumlu Sağlayıcı (Groq, OpenRouter, Mistral vb.)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# ------------------------------------------------------------------------------
# 5. SCRAPING VE İŞ PORTALI AYARLARI
# ------------------------------------------------------------------------------
# Apify Token (İsteğe bağlı - LinkedIn için sıfır-maliyetli public misafir motoru mevcuttur)
APIFY_API_TOKEN=

# Aktif Scraper Platformları (virgülle ayrılmış): linkedin,kosovajob,techcareer,upwork,remote
SCRAPER_PLATFORMS=linkedin,kosovajob,techcareer,upwork,remote
NIGHTLY_SCAN_PLATFORMS=remote,kosovajob,techcareer
DEFAULT_SCRAPE_QUERY="Developer"

# ------------------------------------------------------------------------------
# 6. E-POSTA VE SMTP BAŞVURU AYARLARI
# ------------------------------------------------------------------------------
# E-posta ile tek tıkla başvuru ve gelen kutusu takibi için:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# IMAP Gelen Kutusu Dinleyici (İsteğe bağlı)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# ------------------------------------------------------------------------------
# 7. ZAMANLAYICI VE OTONOM DAEMON AYARLARI
# ------------------------------------------------------------------------------
AUTO_START_DAEMON=false
STARTUP_SEED_ENABLED=false
SCHEDULER_TIMEZONE="Europe/Belgrade"
SCHEDULER_NIGHTLY_TIME="03:30"
SCHEDULER_MORNING_TIME="08:00"
DAEMON_POLL_SECONDS=45
MORNING_MIN_MATCH_SCORE=75
MORNING_DRAFT_LIMIT=3

# ------------------------------------------------------------------------------
# 8. CELERY VE REDIS (İsteğe Bağlı Dağıtık Görev Kuyruğu)
# ------------------------------------------------------------------------------
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0
